# Valeurs de démonstration — aucun secret réel dans ce dépôt.
# Copie ce fichier en .env : cp .env.example .env

POSTGRES_USER=workshop
POSTGRES_PASSWORD=workshop-demo-password
POSTGRES_DB=workshop

# Ports exposés sur ta machine (change-les s'ils sont déjà pris)
POSTGRES_HOST_PORT=5433
APP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Utilisé par `make test` pour lancer pytest en local contre la base Compose
DATABASE_URL=postgresql://workshop:workshop-demo-password@localhost:5433/workshop
